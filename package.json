{
  "name": "hive_site",
  "version": "1.0.0",
  "private": true,
  "description": "Hive Society Improv website",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mts",
    "start:dist": "STATIC_DIR=dist node src/server.mts",
    "export": "node scripts/export.mts",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "node --test",
    "validate:theme": "node scripts/validate-theme.mts",
    "check:form": "node scripts/check-form.mts",
    "check:images": "node scripts/check-images.mts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "colorjs.io": "^0.7.1",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "license": "ISC"
}
